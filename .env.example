# Public Firebase Web SDK configuration. Copy to .env.local and fill from Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=trainer-note-a9dd7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=trainer-note-a9dd7
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_SERVER_AI_ENABLED=true
NEXT_PUBLIC_STORAGE_ENABLED=true
# Local development only; never put a debug token in a production build.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Gemini and Admin credentials belong in server Secret Manager, never NEXT_PUBLIC_*.
