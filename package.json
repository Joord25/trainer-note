{
  "name": "trainer-note",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "npx --yes firebase-tools@latest emulators:start --only hosting --project trainer-note-a9dd7",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-trainer-note \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:ai": "node scripts/build-functions.mjs && node --test functions/tests/domain.test.mjs",
    "test:all": "node scripts/build-functions.mjs && npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-trainer-note \"node --test --test-concurrency=1 functions/tests/*.test.mjs tests/*.test.mjs\"",
    "predev": "node scripts/prepare-pdf-viewer.mjs",
    "prebuild": "node scripts/prepare-pdf-viewer.mjs",
    "postinstall": "node scripts/prepare-pdf-viewer.mjs",
    "deploy:hosting": "npx --yes firebase-tools@latest deploy --only hosting --project trainer-note-a9dd7"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "html2canvas": "1.4.1",
    "next": "^16.3.4",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
