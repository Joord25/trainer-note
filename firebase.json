{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "trainer-note-a9dd7.firebaseapp.com",
      "trainer-note-a9dd7.web.app"
    ],
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Trainer Note",
        "supportEmail": "trainer.note.app@gmail.com"
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9198
    },
    "hosting": {
      "port": 5000
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "trainer-ai",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/build-functions.mjs"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "*.log",
        ".secret.local"
      ]
    }
  ],
  "hosting": {
    "site": "trainer-note-a9dd7",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
